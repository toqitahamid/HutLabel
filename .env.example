# Clerk auth (web build). Copy to .env.local and fill in.
# Publishable key from https://dashboard.clerk.com → API Keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side only (Vercel env vars, never VITE_-prefixed):
# CLERK_SECRET_KEY=      Clerk secret key — verifies session JWTs in api/ functions.
# DATABASE_URL=          Neon Postgres connection string (project: hutlabel / jolly-pond-84970041).

# Base URL for the tile pyramids. Tiles are served as {TILE_BASE}/{ortho_id}/{z}/{x}_{y}.{ext}
# Production: the Cloudflare R2 public bucket URL. Local dev: "/tiles" (decoded demo tileset).
VITE_TILE_BASE=/tiles
# Tile file extension. tiler.py emits png in production; the decoded demo tileset is jpg.
VITE_TILE_EXT=jpg
